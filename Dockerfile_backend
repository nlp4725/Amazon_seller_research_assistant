FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install CPU-only PyTorch first — prevents pip from pulling in the 2GB CUDA build
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download both models so cold starts don't hit HuggingFace. The bi-encoder
# embeds the query (src/shared/model_loader.py); the cross-encoder reranks
# (query, title) pairs in the structured path (src/retrieval_pipeline/reranker.py).
RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; \
    SentenceTransformer('all-MiniLM-L6-v2'); \
    CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')"

COPY . .

# Fail loudly if the build context is missing either live store. .dockerignore
# excludes data/ and re-includes just these two; a silent miss here would ship an
# API that only fails at request time, on the first query.
RUN test -s data/processed/preprocessed_reduced.parquet \
    && test -n "$(ls -A data/raw/chroma_db)" \
    || (echo "FATAL: live data stores missing from build context" >&2; exit 1)

ENV OMP_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV TOKENIZERS_PARALLELISM=false

EXPOSE 8080

# --timeout also bounds worker boot (imports + WARM_UP_ON_BOOT), which can exceed 300s on
# a cold Cloud Run instance; a worker killed mid-boot would restart the whole wait.
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--timeout", "600", "main:app"]
