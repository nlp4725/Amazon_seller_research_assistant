# Data: exclude everything, then re-include only the two stores the API reads at
# request time (src/shared/paths.py). Both are fetched from GCS by cloudbuild.yaml
# before the build, since data/ is gitignored and absent from a git-sourced build.
data/
!data/raw/chroma_db
!data/processed/preprocessed_reduced.parquet
